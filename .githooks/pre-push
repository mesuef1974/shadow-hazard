#!/bin/sh
# فحص ما قبل الدفع — مهمة 0002
# كل مرشح يُجرَّب أولًا: اسم python3 في ويندوز قد يكون اختصار المتجر الذي يفشل.
for py in .venv/Scripts/python.exe .venv/bin/python python python3; do
  if "$py" -c "import sys" >/dev/null 2>&1; then exec "$py" scripts/prepush_check.py; fi
done
echo "pre-push: لم يُعثر على Python" >&2
exit 1
